# Set by `npx convex dev` — do not edit by hand
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# OpenRouter — set OPENROUTER_API_KEY in the Convex dashboard (Settings → Environment Variables)
# so it is available to Convex actions. OPENROUTER_MODEL can also live there.
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
